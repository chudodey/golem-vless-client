# Доступ к серверу Dell (192.168.88.13) — логин/пароль для входа
# с клавиатуры/монитора и по SSH (запасной доступ, если ноутбук/ключ недоступны).
#
# Заполни и сохрани копию как secrets/server-access.txt (файл в .gitignore,
# в git не попадёт). Затем примени на сервере:
#   bash scripts/enable-password-login.sh secrets/server-access.txt
#
# LOGIN:
#   root               — разблокирует root: консоль (монитор+клавиатура) и SSH по паролю
#   любое другое имя   — создаст этого пользователя с sudo; root останется ключевым
#                        (в консоль можно будет войти этим пользователем)
# PASSWORD:  минимум 8 символов, не заглушка.
#
# ⚠️ Парольный SSH действует ТОЛЬКО из локальной сети (192.168.88.0/24);
# извне — только ключевой вход. Консоль (монитор+клавиатура) доступна всегда.
# Сеть можно переопределить переменной GOLEM_SSH_LAN при запуске скрипта.
LOGIN=root
PASSWORD=your_password_here
