@{
    # Проект — консольные скрипты управления VPN (GolemVpn.ps1 и др.).
    # Write-Host здесь осознанный выбор: одноцветный цветной вывод в терминал
    # для человека, а не поток данных для пайплайна. Замена на Write-Output
    # сломала бы текущие скрипты и не дала бы цвета.
    ExcludeRules = @(
        'PSAvoidUsingWriteHost'
    )
}